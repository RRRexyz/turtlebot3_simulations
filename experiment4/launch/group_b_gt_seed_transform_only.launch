<launch>
  <arg name="result_root" default="$(find experiment4)/results" />
  <node pkg="experiment4"
        type="run_experiment4_batch.py"
        name="experiment4_group_b_gt_seed_transform_only"
        output="screen"
        args="--group group_b_gt_seed_transform_only --result-root $(arg result_root)" />
</launch>
