<launch>
  <arg name="result_root" default="$(find experiment4)/results" />
  <node pkg="experiment4"
        type="run_experiment4_batch.py"
        name="experiment4_group_d_gt_seed_overlap_icp"
        output="screen"
        args="--group group_d_gt_seed_overlap_icp --result-root $(arg result_root)" />
</launch>
