<launch>
    <!-- Arguments -->
    <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>
    <arg name="slam_methods" default="gmapping" doc="slam type [gmapping, cartographer, hector, karto, frontier_exploration]"/>
    <arg name="configuration_basename" default="turtlebot3_lds_2d.lua"/>
    <arg name="open_rviz" default="false"/>
    <arg name="ns" default="tb3_1"/>

    <!-- Get frames from outside args -->
    <arg name="base_frame" default="base_footprint"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="map_frame"  default="map"/>

    <!-- SLAM: Gmapping, Cartographer, Hector, Karto, Frontier_exploration, RTAB-Map -->
    <include file="$(find turtlebot3_multislam)/launch/turtlebot3_$(arg slam_methods).launch">
        <arg name="model" value="$(arg model)"/>
        <arg name="configuration_basename" value="$(arg configuration_basename)"/>

        <!-- Transmit frames to SLAM launch -->
        <arg name="set_base_frame" value="$(arg base_frame)"/>
        <arg name="set_odom_frame" value="$(arg odom_frame)"/>
        <arg name="set_map_frame"  value="$(arg map_frame)"/>
    </include>

    <group if="$(arg open_rviz)"> 
        <node pkg="rviz" type="rviz" name="rviz" required="true"
            args="-d $(find turtlebot3_multislam)/rviz/$(arg ns)_$(arg slam_methods).rviz"/>
    </group>
</launch>